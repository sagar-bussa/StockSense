# ------------------------------------------------------------------
# StockSense environment variables
#
# Copy this file to `.env.local` and fill in the values from your
# Supabase project:  Project Settings -> API
#
#   cp .env.example .env.local
#
# NEVER commit a .env file. Only the *anon / publishable* key belongs
# here - it is designed to be public and is protected by Row Level
# Security. A service_role key must never reach the browser; this app
# does not need one at all, because every stock mutation goes through
# a Postgres RPC governed by RLS.
# Create a project in SUPERBASE and then edit the following keys
# ------------------------------------------------------------------

VITE_SUPABASE_URL=https://userID.supabase.co
VITE_SUPABASE_ANON_KEY= ******
